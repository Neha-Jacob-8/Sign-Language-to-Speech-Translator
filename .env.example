# Copy to .env and fill in. All settings are optional.

# Azure AI Speech (neural voice). Without these the app uses the browser's built-in voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_SPEECH_VOICE=en-IN-NeerjaNeural

# T5 grammar correction (needs: pip install -r requirements-grammar.txt)
ENABLE_GRAMMAR=0

# Only needed if the frontend is served from a different origin than the API
CORS_ORIGINS=
